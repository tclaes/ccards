{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/api/src/main/java",
  "tags": [],
  "namedInputs": {
    "maven": [
      "sharedGlobals",
      "{projectRoot}/pom.xml",
      "{projectRoot}/.mvn/**/*",
      "{projectRoot}/mvnw"
    ]
  },
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "readyWhen": {
        "url": "http://localhost:{env.SERVER_PORT ?? 8080}/api/health"
      },
      "options": {
        "command": "./mvnw spring-boot:run",
        "cwd": "apps/api"
      },
      "configurations": {
        "local": {
          "env": {
            "SPRING_PROFILES_ACTIVE": "local"
          }
        }
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["maven", "{projectRoot}/src/main/**/*"],
      "outputs": ["{projectRoot}/target"],
      "options": {
        "command": "./mvnw -B package -DskipTests",
        "cwd": "apps/api"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "maven",
        "{projectRoot}/src/**/*",
        {
          "runtime": "docker info > /dev/null 2>&1 && echo docker-up || echo docker-down"
        }
      ],
      "outputs": ["{projectRoot}/target/surefire-reports"],
      "options": {
        "command": "./mvnw -B test",
        "cwd": "apps/api"
      }
    }
  }
}
